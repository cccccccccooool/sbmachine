# Global OpenAI-compatible API defaults. Scoped values below override these.
AI6657_API_KEY=
AI6657_BASE_URL=
AI6657_LLM_MODEL=

# Optional Phase 3a analyst override.
AI6657_LLMA_API_KEY=
AI6657_LLMA_BASE_URL=
AI6657_LLMA_MODEL=

# Optional Phase 3b style override.
AI6657_LLMB_API_KEY=
AI6657_LLMB_BASE_URL=
AI6657_LLMB_MODEL=

# Optional Phase 2 vision override.
AI6657_VLM_API_KEY=
AI6657_VLM_BASE_URL=
AI6657_VLM_MODEL=

# Override backend for a specific stage: "api" or "vllm" (e.g. AI6657_ANALYST_BACKEND=api)
# AI6657_ANALYST_BACKEND=
# AI6657_STYLE_BACKEND=

# Override VLM service endpoint (default: http://127.0.0.1:23333/v1/chat/completions)
# AI6657_VLM_ENDPOINT=

# Enable phase3 debug output (debug_phase3 JSON dumps written to output/debug_phase3/)
# AI6657_DEBUG_PHASE3=1
